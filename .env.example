# ============================================================
# Smart-Fleet IoT — Environment Variables Template
# TanQHoang © 2026
# Copy this file to .env and fill in your values.
# ALL variables listed here are required unless marked OPTIONAL.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (PostgreSQL + Auth)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# UPSTASH REDIS (Caching + Rate Limiting)
# Get these from: https://console.upstash.com → Redis → REST API
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ------------------------------------------------------------
# OPENWEATHER API (Weather Data)
# Get your key from: https://openweathermap.org/api
# Free tier: 1,000 calls/day — protected by Redis cache (30m TTL)
# ------------------------------------------------------------
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_DEFAULT_CITY=Ho Chi Minh City
OPENWEATHER_DEFAULT_LAT=10.8231
OPENWEATHER_DEFAULT_LON=106.6297

# ------------------------------------------------------------
# GOOGLE MAPS (Route Optimization + Load Factor)
# Enable: Distance Matrix API, Maps JavaScript API
# Get key from: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------------------------
# FIREBASE (FCM Push Notifications)
# Get from: Firebase Console → Project Settings → Service Accounts
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# GEMINI AI (Conversational Maintenance Recommendations)
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------
# APPLICATION CONFIG
# ------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT — generate strong secrets: `openssl rand -base64 64`
JWT_SECRET=your-jwt-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
